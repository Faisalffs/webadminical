<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#22c55e</color>
    <color name="bg_dark">#0B0F19</color>
    <color name="bg_main">#FFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="primary">#0d6efd</color>
    <color name="primary_dark">#0b5ed7</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Cabe Kami</string>
    <style name="Theme.CabeKami" parent="Theme.AppCompat.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        
        
        <item name="android:windowBackground">@color/bg_main</item>
    </style>
    <style name="Theme.CabeKami.Fullscreen" parent="Theme.CabeKami">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        
        
        <item name="android:statusBarColor">@color/primary</item> 
        <item name="android:navigationBarColor">@color/bg_main</item>
    </style>
</resources>